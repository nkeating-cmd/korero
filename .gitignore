node_modules/
dist/
build/
.env

# Kōrero: local release staging (the built installer + latest.json, produced on
# disk only for the GitHub release upload) and build logs are never tracked.
release-staging/
*.log

# Kōrero (v1.27.0): local CodeGraph index — a machine-local cache, ~11 MB,
# regenerated on demand, never source. This entry lives HERE and not in
# C:\dev\korero\.gitignore because .gitignore is an overlay file: sync-to-dev.ps1
# overwrites the live tree's copy on every build, so an edit made directly in the
# dev tree survives exactly until the next sync. (Learned the hard way — it was
# reverted within one build cycle on 2026-08-04.)
.codegraph/

# Generated by apply-patches.ps1 on every build - never source.
KORERO_PATCHES_APPLIED.txt
